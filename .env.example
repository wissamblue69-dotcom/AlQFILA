# --- Core environment ---
ENVIRONMENT=development

# --- Context and messaging ---
REDIS_URL=redis://redis:6379/0
KAFKA_BROKER=kafka:9092
KAFKA_AGENT_TOPIC=qafila.agents.events
KAFKA_CONTEXT_TOPIC=qafila.context.updates

# --- LLM providers: set locally only; never commit real keys ---
OPENAI_API_KEY=your_openai_key_here
GOOGLE_API_KEY=your_gemini_key_here

# --- Cloud ---
GCP_PROJECT_ID=your_gcp_project_id

# --- Browser access to the health endpoint ---
# Add approved UI origins as a comma-separated list. Never use * in production.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://alqfila-dash-7qn4jku7.manus.space
